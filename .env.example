# Database
DATABASE_URL=postgres://outreach:outreach@localhost:5432/outreach
REDIS_URL=redis://localhost:6379

# Google Places API (New)
GOOGLE_PLACES_API_KEY=

# E-mail verzenden (kies één)
RESEND_API_KEY=
# of
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_WEBHOOK_SECRET=

# E-mail finder
HUNTER_API_KEY=

# Afzender
FROM_EMAIL=jouw@agency.nl
FROM_NAME=Jouw Naam
REPLY_TO_EMAIL=jouw@agency.nl
AGENCY_PRIVACY_URL=https://example.com/privacy

# Public URL of the dashboard (used for unsubscribe links in mails)
PUBLIC_BASE_URL=http://localhost:3000

# HMAC secret for signing unsubscribe tokens — generate a random 32+ char string
UNSUBSCRIBE_SECRET=change-me-please-generate-a-real-secret

# AI personalisatie (optioneel — gebruikt Claude voor de "personal observation"
# regel in mails. Zonder key valt het systeem terug op de heuristiek.)
ANTHROPIC_API_KEY=
# Override het model. Default: claude-opus-4-7. Voor 1-zin output is
# claude-haiku-4-5 ~5x goedkoper en ruim voldoende.
AI_MODEL=

# Verzendlimieten
DAILY_SEND_LIMIT=50
SEND_WINDOW_START=9
SEND_WINDOW_END=16
SEND_WEEKDAYS=2,3,4

# Dashboard HTTP basic auth (optioneel — beide moeten gezet zijn om te activeren)
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASS=

# BullMQ tuning (optioneel)
TICK_BATCH_SIZE=50
