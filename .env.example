# Database
DATABASE_URL=postgres://outreach:outreach@localhost:5432/outreach
REDIS_URL=redis://localhost:6379

# Google Places API (New) — also used for Geocoding + PageSpeed Insights
# (enable all three APIs in the same GCP project)
GOOGLE_PLACES_API_KEY=

# Optional: gebruik dezelfde key als GOOGLE_PLACES_API_KEY tenzij je
# een aparte project-key wil voor PageSpeed Insights (kost niets extra).
PSI_API_KEY=

# E-mail verzenden — kies postmark (default) of smtp
MAILER_PROVIDER=postmark

# Postmark (alleen als MAILER_PROVIDER=postmark)
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_WEBHOOK_SECRET=

# SMTP (alleen als MAILER_PROVIDER=smtp)
# SMTP_HOST=smtp.fastmail.com
# SMTP_PORT=587
# SMTP_USER=jouw@agency.nl
# SMTP_PASS=app-password-hier
# SMTP_SECURE=false              # true voor port 465 (implicit TLS), false voor 587 (STARTTLS)
# SMTP_MAX_CONNECTIONS=5         # parallel SMTP-connecties (default 5)
# SMTP_RATE_LIMIT=10             # max berichten per SMTP_RATE_DELTA_MS
# SMTP_RATE_DELTA_MS=1000

# E-mail finder
HUNTER_API_KEY=

# Afzender
FROM_EMAIL=jouw@agency.nl
FROM_NAME=Jouw Naam
REPLY_TO_EMAIL=jouw@agency.nl
AGENCY_PRIVACY_URL=https://example.com/privacy

# Public URL of the dashboard (used for unsubscribe links in mails)
PUBLIC_BASE_URL=http://localhost:3000

# HMAC secret for signing unsubscribe tokens — generate a random 32+ char string
UNSUBSCRIBE_SECRET=change-me-please-generate-a-real-secret

# AI personalisatie (optioneel — gebruikt Claude voor de "personal observation"
# regel in mails. Zonder key valt het systeem terug op de heuristiek.)
ANTHROPIC_API_KEY=
# Override het model. Default: claude-opus-4-7. Voor 1-zin output is
# claude-haiku-4-5 ~5x goedkoper en ruim voldoende.
AI_MODEL=

# Per-send AI-mailgeneratie (optioneel — Claude schrijft per send een
# unieke subject + body o.b.v. business + audit-detail + reviews +
# step-context. Bij failure valt 'ie terug op de sequence-template.
# Vereist ANTHROPIC_API_KEY.)
# AI_GENERATE_EMAILS=true
# AI_EMAIL_MODEL=claude-haiku-4-5

# Verzendlimieten
DAILY_SEND_LIMIT=50
SEND_WINDOW_START=9
SEND_WINDOW_END=16
SEND_WEEKDAYS=2,3,4
# IANA tijdzone waarin start/eind-uren + weekdagen worden geïnterpreteerd.
# Default Europe/Amsterdam. Onmisbaar in Docker: zonder deze waarde valt het
# venster terug op container-tijd (UTC) en gaat 9-16 lokaal pas om 11-18 lokaal lopen.
SEND_TIMEZONE=Europe/Amsterdam

# Domain warmup (optioneel — set BEIDE om de ramp te activeren)
# WARMUP_DAYS=14   # interpoleer over 14 dagen van floor naar DAILY_SEND_LIMIT
# WARMUP_FLOOR=5   # day-0 limit; bouwt langzaam op naar DAILY_SEND_LIMIT

# Bounce-rate circuit breaker (optioneel — set BOUNCE_THRESHOLD om te activeren)
# BOUNCE_THRESHOLD=0.05  # halt tick als bounce-rate > 5%
# BOUNCE_WINDOW=50       # over de laatste N sends
# BOUNCE_MIN_SENT=20     # niet trippen voor we N sends hebben

# Dashboard HTTP basic auth (optioneel — beide moeten gezet zijn om te activeren)
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASS=

# BullMQ tuning (optioneel)
TICK_BATCH_SIZE=50
