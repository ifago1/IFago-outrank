{
  "name": "outreach-tool",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "pnpm --filter @outreach/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @outreach/db generate",
    "db:migrate": "pnpm --filter @outreach/db migrate",
    "db:studio": "pnpm --filter @outreach/db studio",
    "discover": "tsx scripts/discover.ts",
    "enrich": "tsx scripts/enrich.ts",
    "seed-campaign": "tsx scripts/seed-campaign.ts",
    "assign-leads": "tsx scripts/assign-leads.ts",
    "send-tick": "tsx scripts/send-tick.ts"
  },
  "dependencies": {
    "@outreach/db": "workspace:*",
    "@outreach/enrichment": "workspace:*",
    "@outreach/mailer": "workspace:*",
    "@outreach/places": "workspace:*",
    "@outreach/sequencer": "workspace:*",
    "@outreach/templates": "workspace:*",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
